{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for VillFlow main and pill windows",
  "windows": ["main", "pill"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-center",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "notification:default",
    "notification:allow-notify",
    "notification:allow-request-permission",
    "notification:allow-is-permission-granted",
    "core:event:default",
    "allow-get-config-path",
    "allow-get-settings",
    "allow-save-settings",
    "allow-get-api-key",
    "allow-set-api-key",
    "allow-list-audio-devices",
    "allow-open-log-folder",
    "allow-reset-all-settings",
    "allow-list-groq-models",
    "allow-get-default-prompts",
    "allow-get-default-settings",
    "allow-get-default-groq-models"
  ]
}
